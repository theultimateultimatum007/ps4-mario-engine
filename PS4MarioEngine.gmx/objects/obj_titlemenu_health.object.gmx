<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>spr_marker_event</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-5</depth>
  <persistent>0</persistent>
  <parentName>obj_titlemenu</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///The titlescreen menu (When health mode is active)

//Play the title theme
audio_play_sound(bgm_title, 0, true);

//Menu mode
//1: Activating...
//2: Active
//3: Key
mode = 1;
alarm[0] = 30

//Page
page = 0;

//Item
current = 1;

//Save File info
for (i=0; i&lt;3; i++) {

    coins[i] = 0;
    complete[i] = 0;
}

//Menu 0: Main
menu[0,0] = 3;
menu[0,1] = "Start Game"
menu[0,2] = "Options"
menu[0,3] = "Exit"

//PS4: hide Exit and PC-only options
scr_titlemenu_apply_ps4(1);

//Menu 1: File Selection
menu[1,0] = 4;
menu[1,1] = "File A - New!";
menu[1,2] = "File B - New!";
menu[1,3] = "File C - New!";
menu[1,4] = "Back";

//Menu 2: Options
if (scr_is_ps4()) {
    // PS4: remove window size / V-Sync / FPS entirely
    menu[2,0] = 4;
    menu[2,1] = "Controller Configuration";
    menu[2,2] = "Delete Save Data";
    menu[2,3] = "View Credits";
    menu[2,4] = "Back";
    menu[2,5] = "";
    menu[2,6] = "";
}
else {
    menu[2,0] = 6;
    menu[2,1] = "Keyboard Configuration";
    menu[2,2] = "Set Window Size";
    menu[2,3] = "V-Sync: On";
    menu[2,4] = "FPS: On";
    menu[2,5] = "View Credits";
    menu[2,6] = "Back";
}

//Menu 3: Keys 1 / 2
menu[3,0] = 7;
menu[3,1] = "Run, Shoot: " + string(key_to_string(global.controlkey));
menu[3,2] = "Jump, Spin: " + string(key_to_string(global.shiftkey));
menu[3,3] = "Reserve   : " + string(key_to_string(global.spacekey));
menu[3,4] = "Pause     : " + string(key_to_string(global.enterkey));
menu[3,5] = "Reset all keys"
menu[3,6] = "Next"
menu[3,7] = "Back"

//Menu 4: Keys 2 / 2
menu[4,0] = 7;
menu[4,1] = "Up        : " + string(key_to_string(global.upkey));
menu[4,2] = "Down      : " + string(key_to_string(global.downkey));
menu[4,3] = "Left      : " + string(key_to_string(global.leftkey));
menu[4,4] = "Right     : " + string(key_to_string(global.rightkey));
menu[4,5] = "Reset all keys"
menu[4,6] = "Previous";
menu[4,7] = "Back";

//Page 5: Controller configuration (PS4)
bind_wait = 0;
bind_target = 0;
menu[5,0] = 6;
menu[5,1] = "Jump      :";
menu[5,2] = "Run       :";
menu[5,3] = "Reserve   :";
menu[5,4] = "Pause     :";
menu[5,5] = "Back      :";
menu[5,6] = "Back";

//Page 6: Delete save data (PS4)
menu[6,0] = 5;
menu[6,1] = "Delete File 1";
menu[6,2] = "Delete File 2";
menu[6,3] = "Delete File 3";
menu[6,4] = "Delete All";
menu[6,5] = "Back";

//Refresh save slot labels from disk
scr_save_refresh_title_slots();
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Manage keyboard presses

//If the menu is not on key change mode
if (mode == 2) {

    //Circle / cancel — back out of sub-menus (PS4)
    if (scr_titlemenu_cancel())
        exit;

    //If the player presses the 'Up' key
    if (keyboard_check_pressed(global.upkey)) {
    
        //Play 'Move' sound
        audio_play_sound(snd_move, 0, false);
    
        //Cycle between options
        if (current == 1)
            current = menu[page,0];
        else
            current--;
    }
    
    //Otherwise, if the player presses the 'Down' key
    else if (keyboard_check_pressed(global.downkey)) {
    
        //Play 'Move' sound
        audio_play_sound(snd_move, 0, false);
    
        //Cycle between options        
        if (current == menu[page,0])
            current = 1;
        else
            current++;
    }
    
    //Otherwise, if the player presses the 'Shift' key
    else if (keyboard_check_pressed(global.shiftkey)) {
    
        //Page 0: Main
        if (page == 0) {
        
            //Option 1: Start Game
            if (current == 1) {
                
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
                
                //Go to page 1
                page = 1;
                
                //Reset option to 1
                current = 1;
            }
            
            //Option 2: Options
            else if (current == 2) {
            
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
                
                //Go to page 2
                page = 2;
                
                //Reset option to 1
                current = 1;
            }
            
            //Option 3: Exit (PC only)
            else if (current == 3) {
            
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
                
                //Exit the game
                if (!scr_is_ps4())
                    game_end();
            }
        }
        
        //Page 1: File selection
        else if (page == 1) {
        
            //Options 1 to 3: File selection
            if (current != 4) {
        
                //Stop stream if it's playing
                audio_stop_sound(bgm_title);
                
                global.file = scr_save_slot_sav(current);
                
                //If the file exists and loads
                if (scr_save_slot_has_data(current) &amp;&amp; load(global.file)) {
                
                    if (instance_number(obj_curtainout) == 0) {
                    
                        audio_play_sound(snd_enterstage, 0, false);     
                        with (instance_create(view_xview[0]+global.gw/2,view_yview[0]+global.gh/2,obj_curtainout))                        
                            target = rm_map;                        
                    }
                }
                
                //Otherwise, go to the intro screen
                else {

                    if (instance_number(obj_curtainout) == 0) {
                    
                        audio_play_sound(snd_enterstage, 0, false);     
                        with (instance_create(view_xview[0]+global.gw/2,view_yview[0]+global.gh/2,obj_curtainout))
                            target = rm_intro;
                    }                    
                }
            }
            
            //Choice 3: Back
            else if (current == 4) {
                                
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
            
                //Go to page 0
                page = 0;
                
                //Set the choice
                current = 1;       
            }            
        }
        
        //Page 2: Options
        else if (page == 2) {
        
            if (scr_is_ps4()) {
            
                //Option 1: Controller configuration (PS4)
                if (current == 1) {
                    audio_play_sound(snd_correct, 0, false);
                    page = 5;
                    current = 1;
                }
                
                //Option 2: Delete Save Data
                else if (current == 2) {
                    audio_play_sound(snd_correct, 0, false);
                    page = 6;
                    current = 1;
                }
                
                //Option 3: Credits
                else if (current == 3) {
                    audio_stop_sound(bgm_title);
                    if (instance_number(obj_curtainout) == 0) {
                        audio_play_sound(snd_enterstage, 0, false);
                        with (instance_create(view_xview[0]+global.gw/2,view_yview[0]+global.gh/2,obj_curtainout))
                            target = rm_credits;
                    }
                }
                
                //Last item: Back
                else if (current == menu[page,0]) {
                    audio_play_sound(snd_correct, 0, false);
                    page = 0;
                    current = 1;
                }
            }
            else {
            
            //Option 1: Keyboard configuration (PC only; PS4 uses fixed DualShock layout)
            if (current == 1) {
            
                if (scr_is_ps4()) {
                    audio_play_sound(snd_correct, 0, false);
                }
                else if (global.gamepad == false) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Go to page 3
                    page = 3;
                    
                    //Set the choice
                    current = 1;
                }
                
                //Otherwise, play 'Wrong' sound
                else
                    audio_play_sound(snd_wrong, 0, false);
            }
            
            //Option 2: Window size
            else if (current == 2) {
            
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
            
                //Switch filter
                with (obj_persistent) {
                
                    //If the window is not set to fullscreen
                    if (fullscreen == false) {
                
                        //Change filter
                        filter++;
                        
                        //Check if the filter is the second one
                        if (filter == 3) {
                        
                            //Set default filter
                            filter = 0;
                            
                            //Set fullscreen variable
                            fullscreen = true;
                            
                            //Set fullscreen mode
                            window_set_fullscreen(true);                                                             
                        }
                    }
                    
                    //Otherwise, set it to windowed mode
                    else {
                    
                        //Change fullscreen variable
                        fullscreen = false;
                    
                        //Set windowed mode
                        window_set_fullscreen(false);             
                    }
                    
                    //Apply settings
                    event_user(0);   
                }                    
            }
            
            //Option 3: V-Sync
            else if (current == 3) {
            
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
                
                //Enable V-Sync
                with (obj_persistent) {
                
                    //Toggle vertical syncronization
                    vsync = !vsync;
                    
                    //Apply settings
                    event_user(0);
                }
            }
            
            //Option 4: FPS
            else if (current == 4) {
            
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
                
                //Enable FPS on screen
                with (obj_persistent) {
                
                    //Toggle FPS
                    showfps = !showfps;
                }
            }
            
            //Option 5: Credits
            else if (current == 5) {
            
                //Stop stream if it's playing
                audio_stop_sound(bgm_title);
            
                //Go to credits room
                if (instance_number(obj_curtainout) == 0) {
                
                    audio_play_sound(snd_enterstage, 0, false);     
                    with (instance_create(view_xview[0]+global.gw/2,view_yview[0]+global.gh/2,obj_curtainout))
                        target = rm_credits;
                }                              
            }
            
            //Last item: Back
            else if (current == menu[page,0]) {
                            
                //Play 'Correct' sound
                audio_play_sound(snd_correct, 0, false);
                
                //Go to main menu
                page = 0;
                
                //Set the choice
                current = 1;                    
            }
            
            }
        }
        
        //Page 3: Keys 1/2
        else if (page == 3) {
        
            {
        
                //Options 1 to 4
                if (current &lt; 5) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Set 'Key' mode
                    mode = 3;
                    
                    //Switch current
                    switch (current) {
                    
                        case (1): set_keys(0, "Press a key...", vk_control); break;
                        case (2): set_keys(1, "Press a key...", vk_shift); break;
                        case (3): set_keys(2, "Press a key...", vk_space); break;
                        case (4): set_keys(3, "Press a key...", vk_enter); break;
                    }                    
                    
                    //Set 'Active' mode
                    alarm[0] = 3;
                }
            
                //Option 5: Reset keys
                else if (current == 5) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Reset all keys
                    alarm[1] = 1;
                }
                
                //Option 6: Page 2 / 2
                else if (current == 6) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Go to page 4
                    page = 4;
                }
                
                //Last item: Back
                else if (current == menu[page,0]) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Go to page 2
                    page = 2;
                    
                    //Set the choice
                    current = 1;
                }
            }
        }
        
        //Page 2: Keys 2/2
        else if (page == 4) {
                
            {
        
                //Options 1 to 4
                if (current &lt; 5) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Set 'Key' mode
                    mode = 3;
                    
                    //Switch current
                    switch (current) {
                    
                        case (1): set_keys(4, "Press a key...", vk_up); break;
                        case (2): set_keys(5, "Press a key...", vk_down); break;
                        case (3): set_keys(6, "Press a key...", vk_left); break;
                        case (4): set_keys(7, "Press a key...", vk_right); break;
                    }                    
                    
                    //Set 'Active' mode
                    alarm[0] = 3;
                }
            
                //Option 5: Reset keys
                else if (current == 5) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Reset all keys
                    alarm[1] = 1;
                }
                
                //Option 6: Page 2 / 2
                else if (current == 6) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Go to page 4
                    page = 3;
                }
                                
                //Last item: Back
                else if (current == menu[page,0]) {
                
                    //Play 'Correct' sound
                    audio_play_sound(snd_correct, 0, false);
                    
                    //Go to page 2
                    page = 2;
                    
                    //Set the choice
                    current = 1;
                }
            }
        }
        //Page 5: Controller configuration (PS4)
        else if (page == 5) {

            //Options 1..5: start rebinding
            if (current &lt; 6) {
                audio_play_sound(snd_correct, 0, false);
                bind_wait = 1;
                bind_target = current;
            }
            //Last item: Back
            else if (current == menu[page,0]) {
                audio_play_sound(snd_correct, 0, false);
                page = 2;
                current = 1;
            }
        }

        //Page 6: Delete save data (PS4)
        else if (page == 6) {
        
            if (current == 1) {
                audio_play_sound(snd_correct, 0, false);
                scr_save_delete_slot(1);
                scr_save_refresh_title_slots();
            }
            else if (current == 2) {
                audio_play_sound(snd_correct, 0, false);
                scr_save_delete_slot(2);
                scr_save_refresh_title_slots();
            }
            else if (current == 3) {
                audio_play_sound(snd_correct, 0, false);
                scr_save_delete_slot(3);
                scr_save_refresh_title_slots();
            }
            else if (current == 4) {
                audio_play_sound(snd_correct, 0, false);
                scr_save_delete_slot(0);
                scr_save_refresh_title_slots();
            }
            else if (current == menu[page,0]) {
                audio_play_sound(snd_correct, 0, false);
                page = 2;
                current = 1;
            }
        }
    }
}

// Waiting for controller bind (PS4)
if (bind_wait == 1) {

    // Circle/back cancels waiting
    if (gamepad_button_check_pressed(0, global.gp_bind_back)) {
        bind_wait = 0;
    }
    else {
        var btn = scr_gamepad_pick_button(0);
        if (btn != -1) {
            if (bind_target == 1) global.gp_bind_jump = btn;
            else if (bind_target == 2) global.gp_bind_run = btn;
            else if (bind_target == 3) global.gp_bind_reserve = btn;
            else if (bind_target == 4) global.gp_bind_pause = btn;
            else if (bind_target == 5) global.gp_bind_back = btn;

            global.gp_bind_jump_alt = global.gp_bind_jump;

            bind_wait = 0;
        }
    }
}

if (!scr_is_ps4()) {
    //Update V-Sync text
    if (obj_persistent.vsync)
        menu[2,4] = "V-Sync: On";
    else
        menu[2,4] = "V-Sync: Off";
    
    //Update FPS text
    if (obj_persistent.showfps)
        menu[2,5] = "FPS: On";
    else
        menu[2,5] = "FPS: Off";
}
    
//Update Key Text
menu[3,1] = "Run, Shoot: " + string(key_to_string(global.controlkey));
menu[3,2] = "Jump, Spin: " + string(key_to_string(global.shiftkey));
menu[3,3] = "Reserve   : " + string(key_to_string(global.spacekey));
menu[3,4] = "Pause     : " + string(key_to_string(global.enterkey));
menu[4,1] = "Up        : " + string(key_to_string(global.upkey));
menu[4,2] = "Down      : " + string(key_to_string(global.downkey));
menu[4,3] = "Left      : " + string(key_to_string(global.leftkey));
menu[4,4] = "Right     : " + string(key_to_string(global.rightkey));

//Update Controller bind text (PS4)
menu[5,1] = "Jump      : " + scr_gamepad_button_name(global.gp_bind_jump);
menu[5,2] = "Run       : " + scr_gamepad_button_name(global.gp_bind_run);
menu[5,3] = "Reserve   : " + scr_gamepad_button_name(global.gp_bind_reserve);
menu[5,4] = "Pause     : " + scr_gamepad_button_name(global.gp_bind_pause);
menu[5,5] = "Back      : " + scr_gamepad_button_name(global.gp_bind_back);
if (bind_wait == 1)
    menu[5,6] = "Press a button...";
else
    menu[5,6] = "Back";
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
  <PhysicsObjectShape>0</PhysicsObjectShape>
  <PhysicsObjectDensity>0.5</PhysicsObjectDensity>
  <PhysicsObjectRestitution>0.100000001490116</PhysicsObjectRestitution>
  <PhysicsObjectGroup>0</PhysicsObjectGroup>
  <PhysicsObjectLinearDamping>0.100000001490116</PhysicsObjectLinearDamping>
  <PhysicsObjectAngularDamping>0.100000001490116</PhysicsObjectAngularDamping>
  <PhysicsObjectFriction>0.200000002980232</PhysicsObjectFriction>
  <PhysicsObjectAwake>-1</PhysicsObjectAwake>
  <PhysicsObjectKinematic>0</PhysicsObjectKinematic>
  <PhysicsShapePoints/>
</object>
